<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReminNote.Pet</RootNamespace>
    <AssemblyName>ReminNote.Pet</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    独立骨架：不引用主程序项目，不引入第三方 NuGet。
    本目录仅用于独立演示/验证「提醒桌宠」形态；
    未来对接主程序时按 docs/10_HANDOFF.md 迁入 src/windows。
  -->

  <ItemGroup>
    <!-- 精灵图与帧元数据复制到输出目录，运行时按相对路径加载 -->
    <Content Include="Assets\**\*.png;Assets\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
