<Window x:Class="ReminNote.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReminNote 桌宠"
        Width="240" Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="OnWindowClosing">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条：Mock 触发 + 收纳（跑酷时自动隐藏） -->
        <Border x:Name="Toolbar"
                Grid.Row="0"
                Margin="0,4,0,0"
                Padding="6,4"
                HorizontalAlignment="Center"
                CornerRadius="10"
                Background="#E6FFFFFF">
            <StackPanel Orientation="Horizontal">
                <Button Content="任务提醒" Click="OnTriggerTaskReminder" ToolTip="触发一条 Mock 任务提醒" Margin="0,0,4,0"/>
                <Button Content="动漫提醒" Click="OnTriggerAnimeReminder" ToolTip="触发一条 Mock 动漫提醒" Margin="0,0,4,0"/>
                <Button Content="收纳" Click="OnCollapseClick" ToolTip="收纳到托盘"/>
            </StackPanel>
        </Border>

        <!-- 角色卡片：圆角白卡，承载白底角色图（白底与卡片融合，无需抠图） -->
        <Grid Grid.Row="1">
            <!-- 提醒气泡：作为浮层置于角色上方，允许与角色重叠；
                 这样气泡拥有整块卡片区空间，不会被 Auto 行的高度压缩/遮挡 -->
            <Border x:Name="AlertBubble"
                    Panel.ZIndex="2"
                    Margin="14,6,14,10"
                    Padding="14,12"
                    CornerRadius="14"
                    VerticalAlignment="Top"
                    Background="#F7FFFFFF"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    Visibility="{Binding HasReminder, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding ReminderMessage}"
                               Foreground="{StaticResource PetMutedTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReminderTitle}"
                               Foreground="{StaticResource PetTextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReminderBody}"
                               Foreground="{StaticResource PetTextBrush}"
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <!-- WrapPanel：按钮超宽时自动换行，避免横向溢出被裁切 -->
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="完成" Click="OnCompleteClick" Margin="0,0,4,4"/>
                        <Button Content="稍后" Click="OnSnoozeClick" Margin="0,0,4,4"/>
                        <Button Content="忽略" Click="OnIgnoreClick" Margin="0,0,4,4"/>
                        <Button Content="打开主程序" Click="OnOpenMainClick" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 角色主体（透明悬浮） -->
            <Grid Width="200" Height="250"
                  Margin="0,4,0,12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom">
                <Image x:Name="SpriteImage"
                       Stretch="Uniform"
                       Cursor="SizeAll"
                       MouseLeftButtonDown="OnSpriteMouseLeftButtonDown"
                       MouseLeftButtonUp="OnSpriteMouseLeftButtonUp"
                       MouseMove="OnSpriteMouseMove"/>
                <!-- 跑酷台词气泡：跟随角色(配合60fps平滑移动,不再抖) -->
                <Grid x:Name="TalkBubble"
                      Panel.ZIndex="3"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0">
                    <Border x:Name="TalkBorder"
                            Margin="0,0,0,10"
                            Padding="14,10"
                            CornerRadius="14"
                            Background="#FFFFFFFF"
                            BorderBrush="#50000000"
                            BorderThickness="1.5">
                        <TextBlock x:Name="TalkText"
                                   Foreground="{StaticResource PetTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   MaxWidth="220"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Path x:Name="TalkTail"
                          Fill="#FFFFFFFF"
                          Stroke="#50000000"
                          StrokeThickness="1.5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Data="M0,0 L18,0 L9,13 Z"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
